{
  "name": "1o",
  "displayName": "1o",
  "description": "1o syntax and native Rust language server with automatic schema discovery for new 1o file types.",
  "version": "0.2.0",
  "publisher": "1o",
  "repository": "https://github.com/jameshuntt/1oLanguageSupport.git",
  "icon": "icons/client.png",
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:1o",
    "onLanguage:1oserver",
    "onLanguage:1oclient",
    "workspaceContains:**/*.1o",
    "onCommand:1o.build",
    "onCommand:1o.initializeProject",
    "onCommand:1o.serverStatus",
    "workspaceContains:oneo.project.json",
    "workspaceContains:**/*.1o.*"
  ],
  "contributes": {
    "languages": [
      {
        "id": "1o",
        "aliases": [
          "1o"
        ],
        "extensions": [
          ".1o"
        ],
        "icon": {
          "light": "./icons/app.png",
          "dark": "./icons/app.png"
        },
        "configuration": "./language-configuration.json",
        "filenamePatterns": [
          "*.1o.*"
        ]
      },
      {
        "id": "1oserver",
        "aliases": [
          "server"
        ],
        "extensions": [
          ".1o.config",
          ".1o.connectdb",
          ".1o.controller",
          ".1o.helper",
          ".1o.interface",
          ".1o.middleware",
          ".1o.model",
          ".1o.registrar",
          ".1o.server",
          ".1o.services",
          ".1o.utils"
        ],
        "icon": {
          "light": "./icons/server.png",
          "dark": "./icons/server.png"
        },
        "configuration": "./language-configuration.json",
        "filenamePatterns": [
          "*.1o.config",
          "*.1o.connectdb",
          "*.1o.controller",
          "*.1o.helper",
          "*.1o.interface",
          "*.1o.middleware",
          "*.1o.model",
          "*.1o.registrar",
          "*.1o.server",
          "*.1o.services",
          "*.1o.utils"
        ]
      },
      {
        "id": "1oclient",
        "aliases": [
          "client"
        ],
        "extensions": [
          ".1o.brand",
          ".1o.component",
          ".1o.data",
          ".1o.element",
          ".1o.hook",
          ".1o.localforage",
          ".1o.logo",
          ".1o.page",
          ".1o.seo",
          ".1o.service",
          ".1o.sitemap",
          ".1o.slice",
          ".1o.template",
          ".1o.theme",
          ".1o.website",
          ".1o.style",
          ".1o.section",
          ".1o.overlay_zone",
          ".1o.resource",
          ".1o.walkthrough",
          ".1o.story",
          ".1o.program",
          ".1o.node_vocabulary",
          ".1o.application_action",
          ".1o.application_effect",
          ".1o.application_service",
          ".1o.application_slice",
          ".1o.application_state",
          ".1o.runtime_connection"
        ],
        "icon": {
          "light": "./icons/client.png",
          "dark": "./icons/client.png"
        },
        "configuration": "./language-configuration.json",
        "filenamePatterns": [
          "*.1o.brand",
          "*.1o.component",
          "*.1o.data",
          "*.1o.element",
          "*.1o.hook",
          "*.1o.localforage",
          "*.1o.logo",
          "*.1o.page",
          "*.1o.seo",
          "*.1o.service",
          "*.1o.sitemap",
          "*.1o.slice",
          "*.1o.template",
          "*.1o.theme",
          "*.1o.website",
          "*.1o.style",
          "*.1o.section",
          "*.1o.overlay_zone",
          "*.1o.resource",
          "*.1o.walkthrough",
          "*.1o.story",
          "*.1o.program",
          "*.1o.node_vocabulary",
          "*.1o.application_action",
          "*.1o.application_effect",
          "*.1o.application_service",
          "*.1o.application_slice",
          "*.1o.application_state",
          "*.1o.runtime_connection"
        ]
      }
    ],
    "grammars": [
      {
        "language": "1o",
        "scopeName": "source.1o",
        "path": "./syntaxes/1o.tmLanguage.json"
      },
      {
        "language": "1oserver",
        "scopeName": "source.1o",
        "path": "./syntaxes/1o.tmLanguage.json"
      },
      {
        "language": "1oclient",
        "scopeName": "source.1o",
        "path": "./syntaxes/1o.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "1o",
      "properties": {
        "1o.server.path": {
          "type": "string",
          "default": "",
          "description": "Optional absolute executable path. Blank uses the bundled language-server-1o for your platform; falls back to PATH if not bundled."
        },
        "1o.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the 1o language server for .1o documents."
        }
      }
    },
    "commands": [
      {
        "command": "1o.serverStatus",
        "title": "1o: Language Server Status"
      },
      {
        "command": "1o.initializeProject",
        "title": "1o: Initialize Project"
      },
      {
        "command": "1o.build",
        "title": "1o: Build (Configured Builder)"
      }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "vscode:prepublish": "npm run compile -- --minify",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.83.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT OR Apache-2.0",
  "extensionKind": [
    "workspace"
  ]
}
