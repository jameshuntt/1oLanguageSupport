        },
        "wide_placement": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "narrow_placement": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "breakpoint_width": {
          "type": "integer"
        },
        "reference": {
          "type": "string"
        }
